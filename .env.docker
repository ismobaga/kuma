# Yan Kuma Docker — Environment template

# === Core settings ===
PORT=8000
UPLOAD_DIR=/app/uploads
MAX_STORAGE_MB=500

# === ASR (optional, for pre-fill) ===
# Leave blank to skip ASR
# facebook/wav2vec2-large-xlsr-53-bambara  (recommended, best accuracy)
# facebook/wav2vec2-base                   (lightweight, faster)
ASR_MODEL=facebook/wav2vec2-large-xlsr-53-bambara

# === GitHub sync (optional) ===
# Generate at: https://github.com/settings/tokens
# Create data branch first: git checkout --orphan data && git push -u origin data
GITHUB_TOKEN=
GITHUB_REPO=usename/yan_kuma
GITHUB_USER=
GITHUB_EMAIL=

# === Hugging Face sync (optional) ===
# Get token at: https://huggingface.co/settings/tokens
# Create dataset at: https://huggingface.co/new-dataset
HF_TOKEN=
HF_REPO_ID=usename/yan_kuma_bambara_asr

# === Resource settings (advanced) ===
# Adjust based on your server specs
# CONTAINER_CPU=2          # CPU cores (in docker-compose.yml)
# CONTAINER_MEMORY=4G      # RAM limit (in docker-compose.yml)
